{# @var app \Symfony\Bridge\Twig\AppVariable #}
{% macro attributes(attr) -%}
    {%- for attrname, attrvalue in attr -%}
        {{- ' ' -}}
        {%- if attrname in ['placeholder', 'title'] -%}
            {{- attrname }}="{{ translation_domain is same as(false) ? attrvalue : attrvalue|trans(attr_translation_parameters, translation_domain) }}"
        {%- elseif attrvalue is same as(true) -%}
            {{- attrname }}="{{ attrname }}"
        {%- elseif attrvalue is not same as(false) -%}
            {{- attrname }}="{{ attrvalue }}"
        {%- endif -%}
    {%- endfor -%}
{%- endmacro -%}

{%- macro fit(src, width, height, attr, picture_attr = {}) -%}
    {# add support of ChamberOrchestra\FileBundle\Model\File — use relativePath for image filters, falls back to uri #}
    {%- set src = src.relativePath|default(src.uri|default(src)) -%}
    {%- set attr = attr|default({})|merge({width: attr.width|default(width), height: attr.height|default(height), style: 'height: auto', loading: 'lazy', decoding: 'async'}) -%}
    <picture {{ _self.attributes(picture_attr) -}}>
            <source {#
                    #}srcset="{{ asset(src|default('')|fit(width, height, {fit: {density: 3}, output: {format: 'avif'}}), 'file') }} 3x, {#
            #}{{ asset(src|default('')|fit(width, height, {fit: {density: 2}, output: {format: 'avif'}}), 'file') }} 2x, {#
            #}{{ asset(src|default('')|fit(width, height, {output: {format: 'avif'}}), 'file') }} 1x" {#
                    #}type="image/avif"/>
            <source {#
                    #}srcset="{{ asset(src|default('')|fit(width, height, {fit: {density: 3}, output: {format: 'webp'}}), 'file') }} 3x, {#
            #}{{ asset(src|default('')|fit(width, height, {fit: {density: 2}, output: {format: 'webp'}}), 'file') }} 2x, {#
            #}{{ asset(src|default('')|fit(width, height, {output: {format: 'webp'}}), 'file') }} 1x" {#
                    #}type="image/webp"/>
            <source {#
                    #}srcset="{{ asset(src|default('')|fit(width, height, {fit: {density: 3}}), 'file') }} 3x, {#
            #}{{ asset(src|default('')|fit(width, height, {fit: {density: 2}}), 'file') }} 2x, {#
            #}{{ asset(src|default('')|fit(width, height), 'file') }} 1x"/>
            <img src="{{ asset(src|default('')|fit(width, height), 'file') }}" {{ _self.attributes(attr) }} />
    </picture>
{%- endmacro -%}

