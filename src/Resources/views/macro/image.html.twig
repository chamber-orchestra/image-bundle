{%- macro css_fit(src, width, height, use2x = true) -%}

    {# add support of ChamberOrchestra\FileBundle\Model\File — use relativePath for image filters, falls back to uri #}
    {%- set src = src.relativePath|default(src.uri|default(src)) -%}
    {%- set url = (src|default('')|fit(width, height)) -%}
    {%- set webp = (src|default('')|fit(width, height, {output: {format: 'webp'}})) -%}
    {%- set avif = (src|default('')|fit(width, height, {output: {format: 'avif'}})) -%}
    {%- set url2x = (src|default('')|fit(width, height, {fit: {density: 2}})) -%}
    {%- set webp2x = (src|default('')|fit(width, height, {fit: {density: 2}, output: {format: 'webp'}})) -%}
    {%- set avif2x = (src|default('')|fit(width, height, {fit: {density: 2}, output: {format: 'avif'}})) -%}
    {%- set url3x = (src|default('')|fit(width, height, {fit: {density: 3}})) -%}
    {%- set webp3x = (src|default('')|fit(width, height, {fit: {density: 3}, output: {format: 'webp'}})) -%}
    {%- set avif3x = (src|default('')|fit(width, height, {fit: {density: 3}, output: {format: 'avif'}})) -%}

    {%- set url = asset(url, 'file') -%}
    {%- set webp = asset(webp, 'file') -%}
    {%- set avif = asset(avif, 'file') -%}
    {%- set url2x = asset(url2x, 'file') -%}
    {%- set webp2x = asset(webp2x, 'file') -%}
    {%- set avif2x = asset(avif2x, 'file') -%}
    {%- set url3x = asset(url3x, 'file') -%}
    {%- set webp3x = asset(webp3x, 'file') -%}
    {%- set avif3x = asset(avif3x, 'file') -%}

    {%- set attr = {
        style: '' ~
        "--bg-url: url('" ~ url|e('css') ~ "');" ~
        "--bg-url-avif: url('" ~ avif|e('css') ~ "');" ~
        "--bg-url-webp: url('" ~ webp|e('css') ~ "');" ~
        (use2x ?
        "--bg-url-2x: url('" ~ url2x|e('css') ~ "');" ~
        "--bg-url-avif-2x: url('" ~ avif2x|e('css') ~ "');" ~
        "--bg-url-webp-2x: url('" ~ webp2x|e('css') ~ "');" ~
        "--bg-url-3x: url('" ~ url3x|e('css') ~ "');" ~
        "--bg-url-avif-3x: url('" ~ avif3x|e('css') ~ "');" ~
        "--bg-url-webp-3x: url('" ~ webp3x|e('css') ~ "');"
        : '') ~
        '--bg-width: ' ~ width ~ 'px;' ~
        '--bg-height: ' ~ height ~ 'px;',
    } -%}
    {{- _self.attributes(attr) -}}
{%- endmacro -%}

