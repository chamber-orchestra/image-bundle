{
  "name": "chamber-orchestra/image-bundle",
  "type": "symfony-bundle",
  "description": "Symfony 8 bundle for on-demand image processing, resizing, and caching. Supports fit, fill, strip, interlace, WebP/AVIF conversion via cwebp, MozJPEG, pngquant post-processors, filesystem and stream loaders, signed runtime filters, and Twig helpers.",
  "keywords": [
    "symfony",
    "symfony-bundle",
    "image",
    "image-processing",
    "image-resize",
    "image-cache",
    "thumbnail",
    "resize",
    "webp",
    "avif",
    "cwebp",
    "mozjpeg",
    "pngquant",
    "imagine",
    "imagine-bundle",
    "filter",
    "on-demand",
    "cache",
    "twig"
  ],
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Andrew Lukin",
      "email": "lukin.andrej@gmail.com",
      "homepage": "https://github.com/wtorsi",
      "role": "Developer"
    },
    {
      "name": "Girchenko Mikhail",
      "email": "girchenkomikhail@gmail.com",
      "homepage": "https://github.com/baldrys-ed",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/chamber-orchestra/image-bundle/issues",
    "source": "https://github.com/chamber-orchestra/image-bundle"
  },
  "require": {
    "php": "^8.5",
    "imagine/imagine": "^1.3",
    "psr/cache": "^3.0",
    "symfony/config": "8.0.*",
    "symfony/dependency-injection": "8.0.*",
    "symfony/filesystem": "8.0.*",
    "symfony/http-foundation": "8.0.*",
    "symfony/http-kernel": "8.0.*",
    "symfony/mime": "8.0.*",
    "symfony/options-resolver": "8.0.*",
    "symfony/process": "8.0.*",
    "symfony/routing": "8.0.*",
    "ext-exif": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^13.0",
    "psr/log": "^3.0",
    "twig/twig": "^3.0"
  },
  "suggest": {
    "twig/twig": "Required for image_filter, fit, fill, and optimize Twig filters",
    "ext-imagick": "Recommended image driver — enables WebP, AVIF, and advanced format support",
    "ext-gd": "Alternative image driver — lighter footprint, limited format support",
    "cwebp": "CLI binary for converting images to WebP via CwebpPostProcessor",
    "mozjpeg": "CLI binary for JPEG optimisation via MozJpegPostProcessor",
    "pngquant": "CLI binary for PNG compression via PngquantPostProcessor"
  },
  "autoload": {
    "psr-4": {
      "ChamberOrchestra\\ImageBundle\\": ""
    },
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "cs-fix": "vendor/bin/php-cs-fixer fix",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
  }
}
