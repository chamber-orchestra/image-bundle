{
  "name": "chamber-orchestra/image-bundle",
  "type": "symfony-bundle",
  "description": "Symfony bundle for on-demand image processing, caching, and serving",
  "keywords": [
    "symfony",
    "image",
    "processing",
    "cache",
    "imagine",
    "bundle"
  ],
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Andrew Lukin",
      "email": "lukin.andrej@gmail.com",
      "homepage": "https://github.com/wtorsi",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "imagine/imagine": "^1.3",
    "symfony/config": "8.0.*",
    "symfony/dependency-injection": "8.0.*",
    "symfony/filesystem": "8.0.*",
    "symfony/http-foundation": "8.0.*",
    "symfony/http-kernel": "8.0.*",
    "symfony/mime": "8.0.*",
    "symfony/options-resolver": "8.0.*",
    "symfony/process": "8.0.*",
    "symfony/routing": "8.0.*",
    "ext-exif": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "suggest": {
    "twig/twig": "Required for Twig image_filter/fit/fill/optimize filters and macros",
    "psr/cache-implementation": "Required for CacheResolver decorator",
    "ext-imagick": "Recommended image driver (Imagick)"
  },
  "autoload": {
    "psr-4": {
      "ChamberOrchestra\\ImageBundle\\": ""
    },
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
